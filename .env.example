# Copiá a .env para correr local. En Railway cargalas en Variables.

# Usuarios: se crean al arrancar si todavía no existen (no pisa contraseñas de usuarios ya creados).
# Formato: "usuario1:contraseña1,usuario2:contraseña2"
BOOTSTRAP_USERS=
# Admins (separados por coma): ven Ajustes → Administración para dar de alta usuarios.
ADMIN_USERS=

# Postgres: estado de la app (schema DB_SCHEMA) + catálogo re:Invent (schema reinvent).
# En Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}. Local: el docker reinvent-pg.
DATABASE_URL=postgresql://reinvent:reinvent2026@localhost:5433/reinvent
DB_SCHEMA=app

# Railway: montá un Volume en /data (audios de las grabaciones; el SQLite viejo se importa solo al primer arranque)
DATA_DIR=/data

# Speech-to-text (Groq por defecto; con OpenAI: STT_BASE_URL=https://api.openai.com/v1 y STT_MODEL=whisper-1)
# Con STT_PROVIDER=litellm va por el gateway (LLM_BASE_URL y LLM_API_KEY, alias stt-charlas y stt-voz).
STT_PROVIDER=openai
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# LLM (Claude directo). Por el gateway (ver README › Gateway de LLM): LLM_PROVIDER=litellm, LLM_BASE_URL y LLM_API_KEY
# (clave virtual de LiteLLM). LLM_RUTA_<TAREA>=<alias o modelo> fuerza el modelo de una tarea.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
SUMMARY_MODEL=claude-opus-5-5

# Itinerario: modelo que elige y justifica las sesiones recomendadas (catálogo en el schema reinvent de Postgres)
ITINERARY_MODEL=claude-sonnet-5-5
# Chat de búsqueda (Preguntar)
ASK_MODEL=claude-sonnet-5-5

# Búsqueda por significado: modelo multilingüe local (fastembed). off = solo por palabras.
EMBED_PROVIDER=local

# Mapa: key de Google Maps JavaScript API, restringida por dominio en Google Cloud Console.
# Sin esto el itinerario funciona igual, pero sin mapa.
GOOGLE_MAPS_API_KEY=

# Langfuse: claves del proyecto (solo las usa el servidor) para mandar los scores de calidad sobre las trazas y para el
# tablero de LLM del admin. Sin esto, no se mandan scores y no hay tablero. Las trazas las manda el gateway LiteLLM.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Passkeys (WebAuthn): dominio y origen exactos de la app. Sin esto se usa el host del pedido (sirve en local);
# detrás del proxy de Railway conviene fijarlos. Ejemplo con el dominio de staging; en producción va el dominio de producción, sin "www.".
# WEBAUTHN_RP_ID=staging.reinventar.app
# WEBAUTHN_ORIGIN=https://staging.reinventar.app

# IP del cliente para los límites por IP: header donde el proxy deja la IP real. Railway documenta X-Real-IP (default).
# El X-Forwarded-For no se usa (lo manda el cliente).
# IP_CLIENTE_HEADER=X-Real-IP
