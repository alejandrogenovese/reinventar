# Copiá a .env para correr local. En Railway cargalas en Variables.

# Token largo y aleatorio: openssl rand -hex 32
APP_TOKEN=

# Railway: montá un Volume en /data
DATA_DIR=/data

# Speech-to-text (Groq por defecto; con OpenAI: STT_BASE_URL=https://api.openai.com/v1 y STT_MODEL=whisper-1)
STT_PROVIDER=openai
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# LLM (Claude directo). Para usar tu LiteLLM: LLM_PROVIDER=openai, LLM_BASE_URL y LLM_API_KEY
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
SUMMARY_MODEL=claude-opus-5-5

# Itinerario: modelo que elige y justifica las sesiones recomendadas (data/reinvent2026-catalogo.json)
ITINERARY_MODEL=claude-sonnet-5-5
